{
  "name": "zolexora-ims-cloudflare-proxy",
  "version": "1.0.0",
  "description": "Cloudflare Worker reverse proxy & edge-cached session storage for Zolexora IMS",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "build:ui": "node build-ui.js",
    "deploy": "wrangler deploy",
    "kv:create": "wrangler kv namespace create SESSION_KV",
    "kv:create:preview": "wrangler kv namespace create SESSION_KV --preview",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0"
  }
}
