{
  "name": "zolexora-ims-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Zolexora IMS — Enterprise Multi-Tenant Inventory Management Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:user": "npm run build --workspace=@zolexora/ims-user",
    "build:admin": "npm run build --workspace=@zolexora/ims-admin",
    "build:ims": "npm run build --workspace=@zolexora/ims-user",
    "deploy:all": "npm run deploy --workspace=@zolexora/ims-user && npm run deploy --workspace=@zolexora/ims-admin",
    "deploy:user": "npm run deploy --workspace=@zolexora/ims-user",
    "deploy:admin": "npm run deploy --workspace=@zolexora/ims-admin",
    "deploy:ims": "npm run deploy --workspace=@zolexora/ims-user",
    "dev:user": "npm run dev --workspace=@zolexora/ims-user",
    "dev:admin": "npm run dev --workspace=@zolexora/ims-admin",
    "dev:ims": "npm run dev --workspace=@zolexora/ims-user"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
