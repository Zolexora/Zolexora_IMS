# ==============================================================================
# Zolexora IMS — Admin Control Plane Backend Environment Configuration Template
# ==============================================================================
# Security Policy:
# - NEVER commit real credentials, production secrets, or private keys to source control.
# - Copy this template to `.env` for local development: `cp .env.example .env`
# - For production deployments (e.g. Render, Cloudflare), set these variables
#   securely through the hosting dashboard or encrypted secret managers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# Allow development authentication fallback (STRICTLY DISABLED in production)
ALLOW_DEV_AUTH_BYPASS=true

# ------------------------------------------------------------------------------
# 2. SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify internal admin JWTs
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ALGORITHM=HS256

# Comma-separated list of permitted CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3001,https://admin.ims.zolexora.com

# SuperAdmin Identity (Used for master system alerts and platform governance)
SUPERADMIN_EMAIL=admin@zolexora.com

# ------------------------------------------------------------------------------
# 3. DATABASE ENGINE (CLOUDFLARE D1 SERVERLESS SQL)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

