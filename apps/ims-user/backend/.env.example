# ==============================================================================
# Zolexora IMS — User Application Backend Environment Configuration Template
# ==============================================================================
# Security Policy:
# - NEVER commit real credentials, production secrets, or private keys to source control.
# - Copy this template to `.env` for local development: `cp .env.example .env`
# - For production deployments (e.g. Render, Cloudflare), set these variables
#   securely through the hosting dashboard or encrypted secret managers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Active environment: "development", "staging", or "production"
ENVIRONMENT=development

# Network bind host and port
HOST=0.0.0.0
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Allow development authentication fallback without JWT (STRICTLY DISABLED in production)
# Values: true | false

# ------------------------------------------------------------------------------
# 2. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify internal JSON Web Tokens (JWT).
# Generate a secure 256-bit random key (e.g., `openssl rand -hex 32`).
# REQUIRED in production.
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# JWT signing algorithm (Default: HS256)
JWT_ALGORITHM=HS256

# Access token lifespan in minutes (Default: 10080 = 7 days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of permitted CORS origins (no trailing slashes)
# In development, you may use "*"; in production specify explicit domains.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ims.zolexora.com

# ------------------------------------------------------------------------------
# 3. DATABASE ENGINE (CLOUDFLARE D1 SERVERLESS SQL)
# ------------------------------------------------------------------------------
# Cloudflare D1 is the primary serverless relational database engine.

# Cloudflare Account Tag / ID (Find in Cloudflare Dashboard URL or Overview)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare D1 Database UUID
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_uuid

# Cloudflare API Token (Requires "D1:Edit" or "D1:Read" permissions)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTHENTICATION & DATA SYNC (OPTIONAL)
# ------------------------------------------------------------------------------
# Supabase project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase public anonymous API key (safe for browser exposure)
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase secret service role key (Server-only; NEVER expose to client/frontend)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 5. ENTERPRISE & TENANT DEFAULTS
# ------------------------------------------------------------------------------
# Default tenant organization identifier
DEFAULT_ORG_ID=ORG_ZOLEXORA_001

# Default operating currency symbol (e.g., ₹, $, €, £)
DEFAULT_CURRENCY=₹

# SuperAdmin notification and recovery email
SUPERADMIN_EMAIL=admin@zolexora.com
